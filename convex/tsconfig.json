{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "convex/_generated/api": ["../.convex/_generated/api.d.ts"],
      "convex/_generated/server": ["../.convex/_generated/server.d.ts"],
      "convex/values": ["../node_modules/convex/dist/values/index.d.ts"]
    }
  },
  "include": ["./**/*.ts"]
}
